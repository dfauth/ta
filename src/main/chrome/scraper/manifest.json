{
  "name": "market depth scraper",
  "description": "scrapes westpac market depth",
  "version": "0.0.1",
  "manifest_version": 3,
  "action": {
    "default_popup": "scraper.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [{
        "matches": ["https://sharetrading.westpac.com.au/Private/MarketPrices/QuoteSearch/QuoteSearch.aspx?stockCode=*"],
        "js": ["jquery-3.7.1.min.js","onload.js"]
    }],
  "permissions": ["activeTab", "scripting", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://sharetrading.westpac.com.au/Private/MyPortfolio/AccountDetails/Holdings/EquityHoldings.aspx",
    "https://sharetrading.westpac.com.au/Private/Watchlist/WatchlistHome.aspx"
  ]
}
